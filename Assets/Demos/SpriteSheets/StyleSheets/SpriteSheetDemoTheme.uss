:root {
    /* 60% Dominant — dark neutrals (canvas, cards, fields, body text, mute actions) */
    --color-bg: rgb(36, 35, 40);
    --color-surface: rgb(46, 46, 51);
    --color-surface-inset: rgb(41, 40, 45);
    --color-surface-hover: rgb(70, 70, 78);
    --color-surface-active: rgb(52, 52, 60);
    --color-neutral: rgb(84, 84, 84);
    --color-neutral-hover: rgb(110, 110, 110);
    --color-neutral-active: rgb(60, 60, 60);
    --color-toggle-off: rgb(51, 51, 51);
    --color-text: rgb(233, 233, 233);
    --color-text-muted: rgb(209, 209, 209);
    --color-transparent: rgba(0, 0, 0, 0);

    /* 30% Secondary — blue (chrome, secondary buttons, focus ring) */
    --color-secondary: rgb(76, 114, 173);
    --color-secondary-hover: rgb(96, 138, 200);
    --color-secondary-active: rgb(56, 90, 145);
    --color-secondary-muted: rgb(43, 67, 108);
    --color-secondary-focus: rgb(125, 195, 255);

    /* 10% Accent — green (primary CTA, field caret, toggle on) */
    --color-accent: rgb(26, 129, 69);
    --color-accent-hover: rgb(36, 155, 85);
    --color-accent-active: rgb(18, 100, 52);
    --color-accent-bright: rgb(101, 204, 114);
}
