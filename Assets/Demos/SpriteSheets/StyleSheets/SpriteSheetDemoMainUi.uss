.error-message-panel {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background-color: var(--color-bg--overlay);
    justify-content: center;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-content: center;
    align-items: center;
}

.error-message-panel__container {
    height: 30%;
    position: absolute;
    width: 35%;
    background-color: var(--color-surface);
    border-radius: 5px;
    border-width: 3px;
    border-color: rgb(180, 35, 35);
}

.error-message-panel__close-button {
    height: 10%;
    aspect-ratio: 1;
    position: absolute;
    top: 0;
    right: 0;
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-text);
    background-color: var(--color-text);
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.error-message-panel__close-button:active,
.error-message-panel__close-button:active > .error-message-panel__close-button-image{
    scale: 0.95 0.95;
}

.error-message-panel__close-button,
.error-message-panel__close-button-image {
    transition-duration: 0.1s;
}

.error-message-panel__close-button-image {
    position: absolute;
    top: 50%;
    right: 0;
    bottom: 0;
    left: 50%;
    width: 110%;
    height: 110%;
    translate: -50% -50%;
}

.error-message-panel__title {
    max-height: 15%;
    min-height: 15%;
    min-width: 100%;
    max-width: 100%;
    font-size: 18px;
    -unity-font-style: bold;
    padding-top: 10px;
    padding-right: 48px;
    padding-bottom: 10px;
    padding-left: 20px;
    -unity-text-align: lower-left;
    color: var(--color-text);
    picking-mode: ignore;
}

.error-message-panel__message-body {
    flex-grow: 1;
    flex-shrink: 0;
    max-width: 100%;
    max-height: 80%;
    padding-top: 0;
    padding-right: 20px;
    padding-bottom: 10px;
    padding-left: 20px;
    -unity-text-align: middle-center;
    font-size: 16px;
    color: var(--color-text);
    picking-mode: ignore;
}
