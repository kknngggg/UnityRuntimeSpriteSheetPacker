@import url("./SpriteSheetDemoTheme.uss");

#SpriteSheetDemoPanel,
#SpritePackEntryList {
    background-color: var(--color-bg);
}

#VerticalDivider {
    background-color: var(--color-secondary-muted);
}

#PackedTexturePreviewPanel__page-info {
    color: var(--color-text);
}

#PackedTexturePreviewPanel {
    top: 0;
    right: 0;
    bottom: 0;
    left: 65%;
    width: 35%;
    height: 100%;
    background-color: var(--color-bg);
}

.panel-title {
    color: var(--color-text);
    -unity-font-style: bold;
    font-size: 32px;
    width: 100%;
    height: 64px;
    min-height: 48px;
    max-height: 80px;
    -unity-text-align: middle-left;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 34px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.packing-settings__input {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    height: 48px;
}

.packing-settings__input--label {
    width: 45%;
    flex-shrink: 0;
    color: var(--color-text);
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.packing-settings__input--field {
    flex-grow: 1;
    min-width: 0;
    font-size: 24px;
    white-space: nowrap;
    color: var(--color-text);
}

.packing-settings__input--field > .unity-base-field__label {
    display: none;
}

.packing-settings__input--field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
    background-color: var(--color-surface-inset);
}

.packing-settings__input--toggle {
    margin-left: 4px;
}

.packing-settings__input--toggle,
.packing-settings__input--toggle > .unity-toggle__input {
    height: 100%;
    aspect-ratio: 1;
}

.packing-settings__input--toggle > .unity-toggle__input {
    background-color: var(--color-surface-inset);
}

.packing-settings__input--toggle .unity-toggle__checkmark {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-image: none;
    background-color: var(--color-toggle-off);
}

.packing-settings__input--toggle:checked .unity-toggle__checkmark {
    background-color: var(--color-accent-bright);
}

.sheet-entries__add-button {
    background-color: var(--color-secondary);
    border-width: 2px;
    border-color: var(--color-transparent);
}

.sheet-entries__add-button:hover:enabled {
    background-color: var(--color-secondary-hover);
}

.sheet-entries__add-button:active:enabled {
    background-color: var(--color-secondary-active);
    scale: 0.97 0.97;
}

.pack-this-sheet-button {
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    margin-top: 30px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    background-color: var(--color-accent);
    color: var(--color-text);
    -unity-font-style: bold;
    height: 80px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 48px;
    border-width: 2px;
    border-color: var(--color-transparent);
}

.pack-this-sheet-button:hover:enabled {
    background-color: var(--color-accent-hover);
}

.pack-this-sheet-button:active:enabled {
    background-color: var(--color-accent-active);
    scale: 0.97 0.97;
}

.paginaton-controls {
    align-items: center;
    flex-shrink: 0;
    overflow: visible;
}

.paginaton-controls__btn {
    width: auto;
    aspect-ratio: 1;
    height: 100%;
    flex-shrink: 0;
    padding: 3px;
    border-width: 2px;
    border-color: var(--color-transparent);
    background-color: var(--color-secondary);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.paginaton-controls__btn:hover:enabled {
    background-color: var(--color-secondary-hover);
}

.paginaton-controls__btn:active:enabled {
    background-color: var(--color-secondary-active);
    scale: 0.97 0.97;
}

.paginaton-controls__btn:disabled {
    opacity: 0.4;
    scale: 1 1;
}

.paginaton-controls__dropdown {
    color: var(--color-text);
    font-size: 28px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.paginaton-controls__dropdown > .unity-base-field__input {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    background-color: var(--color-surface-inset);
}

.paginaton-controls__dropdown:hover:enabled > .unity-base-field__input {
    background-color: var(--color-surface-hover);
}

.paginaton-controls__dropdown:active:enabled > .unity-base-field__input {
    background-color: var(--color-surface-active);
}

.sheet-entries__add-button:focus,
.pack-this-sheet-button:focus,
.paginaton-controls__btn:focus,
.paginaton-controls__dropdown:focus,
.paginaton-controls__dropdown:focus > .unity-base-field__input,
.paginaton-controls__dropdown > .unity-base-field__input:focus {
    border-color: var(--color-secondary-focus);
    border-width: 2px;
}

.sheet-entries__add-button,
.pack-this-sheet-button,
.paginaton-controls__btn,
.paginaton-controls__dropdown,
.packing-settings__input--field > .unity-base-field__input {
    transition-duration: 0.1s;
}

.packing-settings__input--field:active > .unity-base-field__input,
.packing-settings__input--field:focus > .unity-base-field__input,
.packing-settings__input--field > .unity-base-field__input:focus {
    border-left-width: 10px;
    border-left-color: var(--color-accent-bright);
}
