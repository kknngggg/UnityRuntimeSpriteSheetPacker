@import url("./SpriteSheetDemoTheme.uss");

.sprite-pack-entry {
    background-color: var(--color-surface);
    min-width: 0;
}

.sprite-pack-entry__input {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    justify-content: space-between;
}

.sprite-pack-entry__input--label {
    width: 45%;
    flex-shrink: 0;
    color: var(--color-text);
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.sprite-pack-entry__input--field {
    flex-grow: 1;
    min-width: 0;
    font-size: 24px;
    white-space: nowrap;
    color: var(--color-text);
    max-width: 50%;
}

.pivot-input-field__label {
    color: var(--color-text);
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
}

.pivot-input-field__field {
    font-size: 24px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    flex-grow: 1;
    width: auto;
    min-width: 80px;
    max-width: 302px;
    color: var(--color-text);
}

.sprite-pack-entry__input--field > .unity-base-field__label {
    display: none;
}

.sprite-pack-entry__input--field > .unity-base-field__input,
.sprite-pack-entry__input--field > .unity-enum-field__input {
    background-color: var(--color-surface-inset);
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    margin: 0;
}

.pivot-input-field__field > .unity-base-field__label {
    display: none;
}

.pivot-input-field__field .unity-base-field__input {
    background-color: var(--color-surface-inset);
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.sprite-pack-entry__bottm-button {
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 48px;
    flex-shrink: 0;
    flex-grow: 1;
    max-width: 280px;
    border-width: 2px;
    border-color: var(--color-transparent);
}

.sprite-pack-entry__bottm-button:focus {
    border-color: var(--color-secondary-focus);
    border-width: 2px;
}

.sprite-pack-entry__bottm-button--remove {
    background-color: var(--color-neutral);
    color: var(--color-text-muted);
}

.sprite-pack-entry__bottm-button--remove:hover:enabled {
    background-color: var(--color-neutral-hover);
}

.sprite-pack-entry__bottm-button--remove:active:enabled {
    background-color: var(--color-neutral-active);
    scale: 0.97 0.97;
}

.sprite-pack-entry__bottm-button--browse {
    background-color: var(--color-secondary);
}

.sprite-pack-entry__bottm-button--browse:hover:enabled {
    background-color: var(--color-secondary-hover);
}

.sprite-pack-entry__bottm-button--browse:active:enabled {
    background-color: var(--color-secondary-active);
    scale: 0.97 0.97;
}

.sprite-pack-entry__bottm-button,
.sprite-pack-entry__bottm-button,
.sprite-pack-entry__input--field > .unity-base-field__input,
.pivot-input-field__field > .unity-base-field__input,
.pivot-input-field__field > .unity-base-field__input {
    transition-duration: 0.1s;
}

.sprite-pack-entry__input--field:active > .unity-base-field__input,
.sprite-pack-entry__input--field:active > .unity-base-field__input,
.sprite-pack-entry__input--field:focus > .unity-base-field__input,
.sprite-pack-entry__input--field:focus > .unity-base-field__input,
.pivot-input-field__field:active > .unity-base-field__input,
.pivot-input-field__field:active > .unity-base-field__input,
.pivot-input-field__field:focus > .unity-base-field__input,
.pivot-input-field__field:focus > .unity-base-field__input {
    border-left-width: 10px;
    border-left-color: var(--color-accent-bright);
}
