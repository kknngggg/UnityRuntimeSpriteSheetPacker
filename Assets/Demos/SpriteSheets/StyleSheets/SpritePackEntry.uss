.sprite-pack-entry__input {
    flex-direction: row;
    flex-shrink: 0;
    flex-grow: 0;
    height: 64px;
}

.sprite-pack-entry__input--label {
    width: 45%;
    flex-shrink: 0;
    color: rgb(233, 233, 233);
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.sprite-pack-entry__input--field {
    flex-grow: 1;
    min-width: 0;
    font-size: 24px;
    white-space: nowrap;
    color: rgb(27, 27, 27);
}

.sprite-pack-entry__input--field > .unity-base-field__label {
    display: none;
}

.sprite-pack-entry__input--field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.pivot-input-field__label {
    color: rgb(233, 233, 233);
    white-space: nowrap;
    -unity-text-align: middle-left;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 32px;
}

.pivot-input-field__field {
    font-size: 24px;
    -unity-text-align: middle-left;
    flex-shrink: 0;
    flex-grow: 1;
    width: auto;
    min-width: 80px;
    max-width: 302px;
    color: rgb(27, 27, 27);
}

.pivot-input-field__field > .unity-base-field__label {
    display: none;
}

.pivot-input-field__field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.sprite-pack-entry__bottm-button {
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    color: rgb(233, 233, 233);
    -unity-font-style: bold;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 48px;
    flex-shrink: 0;
    flex-grow: 1;
    max-width: 280px;
}
