{
  "name": "com.kknngggg.runtimespritesheetgenerator",
  "displayName": "Runtime SpriteSheet Packer",
  "version": "0.1.0",
  "unity": "2021.3",
  "description": "Pack SpritePackEntry lists into runtime sprite sheets and fetch Unity Sprite objects by name. Each entry sets name, pixels per unit, pivot, and mesh type. Supports multi-page atlases, padding, max page size, and power-of-two pages. API is shaped like SpriteAtlas and is usable in player builds",
  "license": "MIT",
  "licensesUrl": "https://github.com/kknngggg/SpriteSheetPacker/blob/upm/Packages/com.kknngggg.runtimespritesheetgenerator/Third%20Party%20Notices.md",
  "changelogUrl": "https://github.com/kknngggg/SpriteSheetPacker/blob/upm/Packages/com.kknngggg.runtimespritesheetgenerator/CHANGELOG.md",
  "documentationUrl": "https://github.com/kknngggg/SpriteSheetPacker/blob/upm/Packages/com.kknngggg.runtimespritesheetgenerator/Documentation/index.md",
  "keywords": [
    "sprite",
    "spritesheet",
    "atlas",
    "texture packing",
    "runtime",
    "webgl"
  ],
  "dependencies": {
    "com.unity.test-framework": "^1.6.0"
  },
